# Production Environment Configuration
# This file contains production-specific environment variables

# Database Configuration
DATABASE_URL=postgresql://shortshub_user:${DB_PASSWORD}@/shortshub?host=/cloudsql/corded-cable-460921-u1:us-central1:shortshub-postgres

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT_ID=corded-cable-460921-u1
GOOGLE_CLOUD_STORAGE_BUCKET=shortshub-video-storage

# Server Configuration
NODE_ENV=production
PORT=5000
CORS_ORIGIN=https://shortshub.app

# Authentication Configuration
PROD_CALLBACK_URL=https://shortshub.app/api/callback
PROD_FRONTEND_URL=https://shortshub.app

# Security Configuration
SESSION_SECRET=${SESSION_SECRET}
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# API Configuration
YOUTUBE_API_KEY=${YOUTUBE_API_KEY}
GEMINI_API_KEY=${GEMINI_API_KEY}

# Monitoring
HEALTH_CHECK_PATH=/api/health
