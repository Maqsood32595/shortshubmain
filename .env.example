# ===================================================================
# Application Environment
# ===================================================================
NODE_ENV=development
PORT=5000

# ===================================================================
# Database Configuration
# ===================================================================
# For local development with PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/shortshub

# For Google Cloud SQL (production)
# DATABASE_URL=postgresql://username:password@/shortshub?host=/cloudsql/YOUR_PROJECT_ID:us-central1:shortshub-postgres

# ===================================================================
# Google OAuth Configuration
# ===================================================================
# Get these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===================================================================
# Session Configuration
# ===================================================================
# Generate a strong random string for session encryption
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ===================================================================
# Google Cloud Storage Configuration
# ===================================================================
# Your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Cloud Storage bucket name for video files
GCS_BUCKET_NAME=shortshub-videos

# ===================================================================
# Authentication URLs
# ===================================================================
# Development URLs
DEV_CALLBACK_URL=http://localhost:5000/api/callback
DEV_FRONTEND_URL=http://localhost:5000

# Production URLs
PROD_CALLBACK_URL=https://shortshub.app/api/callback
PROD_FRONTEND_URL=https://shortshub.app

# ===================================================================
# AI Service Configuration (Optional)
# ===================================================================
# OpenAI API Key (if using OpenAI for AI features)
OPENAI_API_KEY=your-openai-api-key

# Replicate API Key (if using Replicate for AI video generation)
REPLICATE_API_TOKEN=your-replicate-api-token

# ===================================================================
# Social Media Platform Keys (Optional)
# ===================================================================
# TikTok API credentials
TIKTOK_CLIENT_ID=your-tiktok-client-id
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Instagram/Facebook API credentials
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# YouTube API credentials
YOUTUBE_API_KEY=your-youtube-api-key

# ===================================================================
# Email Configuration (Optional - for notifications)
# ===================================================================
# SendGrid API key
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@shortshub.app

# ===================================================================
# Redis Configuration (Optional - for caching/sessions)
# ===================================================================
# Redis URL for session storage (if not using PostgreSQL)
REDIS_URL=redis://localhost:6379

# ===================================================================
# Monitoring & Analytics
# ===================================================================
# Google Analytics tracking ID
GA_TRACKING_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ===================================================================
# Development Tools
# ===================================================================
# Enable detailed logging
DEBUG=shortshub:*

# Vite development server port
VITE_PORT=5173
